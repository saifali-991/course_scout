# ============================================================
# CourseScout — backend environment  (copy me to `.env`)
# NEVER commit the real `.env` — it is already in .gitignore.
# ============================================================

# ---- Django ----
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- MySQL (FILL THESE IN!) ----
# Create the database:  CREATE DATABASE learning_platform CHARACTER SET utf8mb4;
DB_NAME=learning_platform
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- CORS (comma-separated frontend origins) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- External APIs ----
# Optional: enables YouTube course imports in `import_resources`
# (free key: https://console.cloud.google.com → APIs & Services → YouTube Data API v3)
YOUTUBE_API_KEY=
