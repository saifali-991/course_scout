# ─────────────────────────────────────────────────────────────────────────────
#  CourseScout frontend — SAMPLE env file (safe to commit, no secrets inside)
#
#  How to use it:  copy .env.example .env      (PowerShell: Copy-Item .env.example .env)
#  `.env` is gitignored, so your own values never reach GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# Where the Django backend lives. Rules: no trailing slash, no /api suffix
# (src/api.js appends /api on its own).
#
#   local dev : http://localhost:8000
#   deployed  : https://<your-service>.onrender.com
#
# On Render this same variable must be set in the dashboard:
#   your frontend service → Environment → Environment Variables → VITE_API_URL
# (Vite bakes it in at build time, so set it BEFORE the build and redeploy.)
VITE_API_URL=http://localhost:8000

# Optional escape hatch: a complete API path of your own, e.g.
#   VITE_API_BASE=https://site.com/v2/api
# If set, it wins over VITE_API_URL.
# VITE_API_BASE=


# Google OAuth - the Web application Client ID from Google Cloud Console
# (APIs & Services -> Credentials -> OAuth client ID -> Web application).
# Same value as GOOGLE_CLIENT_ID on the backend. Empty -> the Sign-in button
# shows a not-configured hint instead of loading.

VITE_GOOGLE_CLIENT_ID=